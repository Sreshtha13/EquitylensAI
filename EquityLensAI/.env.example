# ==============================================================================
# EquityLensAI — Root Environment Configuration Template
# ==============================================================================
# Copy values into backend/.env and frontend/.env.local for local development.
# Never commit real credentials or production secrets to source control.

# --- Backend Service Configuration ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# --- Supabase PostgreSQL Integration ---
# Required for persistent production storage. If omitted, backend runs with in-memory stores.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
JWT_SECRET=your-secure-random-32-character-secret-key-placeholder

# --- AI Intelligence (Google Gemini) ---
# Required only if AI_RESEARCH_ENABLED=true.
AI_RESEARCH_ENABLED=false
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=2
AI_RESEARCH_RATE_LIMIT=5

# --- Angel One Market Provider (NSE/BSE Indian Equities) ---
# Optional: If omitted, backend falls back gracefully to Yahoo Finance quote/chart feeds.
ANGEL_API_KEY=your-angel-api-key-placeholder
ANGEL_CLIENT_ID=your-angel-client-code-placeholder
ANGEL_PASSWORD=your-angel-pin-or-password-placeholder
ANGEL_TOTP_SECRET=your-totp-base32-secret-placeholder

# --- Background Schedulers & Workers ---
ALERT_SCHEDULER_ENABLED=true
ALERT_EVALUATION_INTERVAL_MS=60000
ALERT_MAX_RULES_PER_USER=50

# --- Frontend Application Configuration (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
