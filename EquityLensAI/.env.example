# Copy values into backend/.env and frontend/.env.local as documented in docs/development.md.

# --- Backend (Phase 1 required) ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# --- Frontend (Phase 1 required) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Optional future integrations (not required to start Phase 1) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI research (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=2
AI_RESEARCH_ENABLED=false
AI_RESEARCH_RATE_LIMIT=5

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
