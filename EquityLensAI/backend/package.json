{
  "name": "@equitylensai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:instruments": "tsx scripts/ingest-instruments.ts",
    "ingest:screener": "tsx scripts/ingest-screener-financials.ts",
    "ai:smoke": "tsx scripts/gemini-smoke-test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@equitylensai/shared": "0.1.0",
    "@google/genai": "^2.30.0",
    "@scalar/express-api-reference": "^0.10.29",
    "@types/pdfkit": "^0.17.7",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "node-fetch": "^3.3.2",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pino": "^9.9.0",
    "yahoo-finance2": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/hpp": "^0.2.6",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
