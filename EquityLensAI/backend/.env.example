NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Optional future integrations — not required for Phase 1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Research (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=2
AI_RESEARCH_ENABLED=false
AI_RESEARCH_RATE_LIMIT=5

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Phase 9: Alerts & Notifications
ALERT_SCHEDULER_ENABLED=true
ALERT_EVALUATION_INTERVAL_MS=60000
ALERT_MAX_RULES_PER_USER=50

# Optional Email Provider (Disabled by default - in-app notification is active)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=alerts@equitylensai.com
