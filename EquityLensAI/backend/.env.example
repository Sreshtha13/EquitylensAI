# ==============================================================================
# EquityLensAI Backend — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env with real credentials.

# Service runtime
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Supabase PostgreSQL persistence (PostgREST API)
# If left empty, backend starts in in-memory fallback mode for local testing.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
JWT_SECRET=your-secure-random-32-character-secret-key-placeholder

# AI Research & Screening (Google Gemini)
# If AI_RESEARCH_ENABLED=true, GEMINI_API_KEY must be provided.
AI_RESEARCH_ENABLED=false
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_RETRIES=2
AI_RESEARCH_RATE_LIMIT=5

# Angel One SmartAPI (Market Data Provider for NSE/BSE)
# If credentials are not provided, system falls back to secondary market providers.
ANGEL_API_KEY=your-angel-api-key-placeholder
ANGEL_CLIENT_ID=your-angel-client-code-placeholder
ANGEL_PASSWORD=your-angel-pin-or-password-placeholder
ANGEL_TOTP_SECRET=your-totp-base32-secret-placeholder

# Phase 9: Alerts & Notification Engine
ALERT_SCHEDULER_ENABLED=true
ALERT_EVALUATION_INTERVAL_MS=60000
ALERT_MAX_RULES_PER_USER=50

# Optional Email Notification Provider (disabled by default)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key
# EMAIL_FROM=alerts@equitylensai.com
